rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /publicServices/{documentId} {
      allow get: if documentId == 'current';
      allow list, delete: if false;
      allow create, update: if documentId == 'current'
        && isAdmin()
        && request.resource.data.keys().hasOnly(['categories', 'updatedAt'])
        && request.resource.data.categories is list
        && request.resource.data.categories.size() <= 100
        && request.resource.data.updatedAt is string;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
