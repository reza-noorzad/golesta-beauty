rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /publicServices/current { allow get: if true; allow list, write: if false; }
    // All writes go through authenticated, validated server endpoints.
    // Includes private drafts in golestaV2 and upload rate limits.
    match /{document=**} { allow read, write: if false; }
  }
}
