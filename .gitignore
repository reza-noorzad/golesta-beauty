client_secret*.json
*firebase-adminsdk*.json
firebase-admin*.json
*.pem
*.key
*.p12
*.pfx
*.jks
.aws/

# Dependencies and generated application output at every depth.
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches/
!.yarn/plugins/
!.yarn/releases/
!.yarn/versions/
.next/
out/
dist/
build/
.vercel/
.firebase/
*.tsbuildinfo
next-env.d.ts

# Local archives and duplicate application; preserve files on disk.
backup/
backups/
.backups/
*-backup*/
*[Bb]ackup*/
*.bak
*.zip
*.7z
*.rar
*.tar
*.tar.gz
/v2/v2/
/v2/reference/
*-backup-*.ts.txt
golesta*-source*.txt
*source-export*.txt

